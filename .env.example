# Copy to .env.local for local dev, and set the same values in Vercel
# (Project → Settings → Environment Variables) for production.
#
# All four are needed for Google sign-in and cross-device progress. Without
# them the app still runs — it just falls back to localStorage-only progress
# and hides the sign-in button.

# --- Auth.js ---
# Generate with:  npx auth secret     (or: openssl rand -base64 32)
AUTH_SECRET=

# From Google Cloud Console → APIs & Services → Credentials
# → Create OAuth client ID → Web application.
# Authorised redirect URIs must include:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Progress storage ---
# Any Postgres connection string (Neon, Supabase, Vercel Postgres).
# Use the POOLED endpoint — serverless opens a connection per invocation and
# will exhaust a direct one.
DATABASE_URL=

# Only needed if Auth.js cannot work out its own URL (most hosts set this for you).
# AUTH_URL=https://your-domain.example

# --- Admin dashboard (/admin) ---
# Never store the password itself. Generate the hash with:
#   node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log(s+':'+c.scryptSync(process.argv[1],s,64).toString('hex'))" 'your-password'
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
